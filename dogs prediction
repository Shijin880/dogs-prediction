    <script>
        // JavaScript for the demo functionality
        document.getElementById('imageUpload').addEventListener('change', function(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const preview = document.getElementById('preview');
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                }
                reader.readAsDataURL(file);
            }
        });
        
        document.getElementById('predictButton').addEventListener('click', function() {
            if (!document.getElementById('preview').src) {
                alert('Please upload an image first');
                return;
            }
            
            // Show results section
            document.getElementById('resultSection').style.display = 'block';
            
            // Simulate prediction (in a real app, this would call a backend API)
            setTimeout(function() {
                // Example dog predictions
                const predictions = [
                    { label: 'Airedale', score: 83.01 },
                    { label: 'Lakeland_terrier', score: 6.59 },
                    { label: 'Border_terrier', score: 2.46 },
                    { label: 'wire-haired_fox_terrier', score: 1.42 },
                    { label: 'otterhound', score: 0.94 }
                ];
                
                // Update the UI with predictions
                for (let i = 0; i < predictions.length; i++) {
                    document.getElementById(`prediction${i+1}`).textContent = 
                        `${i+1}: ${predictions[i].label} (${predictions[i].score.toFixed(2)}%)`;
                }
                
                document.getElementById('isDog').textContent = 'Is this a dog? Yes';
            }, 1000);
        });
    </script>
